// use prisma-8

enum MessageRole {
  @@type("mongo/string@1")
  User      = "user"
  Assistant = "assistant"
}

type ImageAttachment {
  mediaType String
  data      String
}

model Message {
  id        ObjectId          @id @map("_id")
  sessionId String
  role      MessageRole
  content   String
  images    ImageAttachment[]
  createdAt DateTime

  @@index([sessionId])
  @@map("messages")
}
